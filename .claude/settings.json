{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv tool list)",
      "Bash(uvx:*)",
      "Bash(rtk:*)",
      "Bash(rg:*)",
      "Bash(gh:*)",
      "Bash(npx bmad-method:*)",
      "Bash(npx bmad-method@*:*)",
      "Bash(crewai:*)",
      "Read(//home/hsantos/app/**)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
