{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "markdown-studio",
  "version": "1.2.0",
  "description": "Editor Markdown com preview em tempo real — projeto pessoal e profissional. Reconstrução do tanabe/markdown-live-preview sob metodologia BMAD.",
  "keywords": [
    "markdown",
    "editor",
    "preview",
    "mermaid",
    "monaco",
    "vite"
  ],
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsoservicos/markdown-studio-live.git"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve-dist": "http-server dist -p 5001 -c-1",
    "build-and-serve": "npm run build && npm run serve-dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,yaml,md}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,json,yaml,md}\"",
    "quality": "npm run format:check && npm run lint && npm run lint:md && npm test",
    "prepare": "husky",
    "release": "node scripts/bump-version.js patch",
    "release:minor": "node scripts/bump-version.js minor",
    "release:major": "node scripts/bump-version.js major",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:dev": "docker compose -f compose.dev.yaml up",
    "docker:dev:down": "docker compose -f compose.dev.yaml down",
    "docker:clean": "docker compose down --rmi local --volumes",
    "docker:audit": "bash scripts/docker-audit.sh",
    "docker:shell": "docker exec -it markdown-studio sh",
    "docker:status": "bash scripts/docker.sh status"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "github-markdown-css": "^5.9.0",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.18.5",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.53.0",
    "pdfmake": "^0.3.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.7.4",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "npm run lint:fix",
      "npm run format:fix"
    ],
    "*.{json,yaml,md}": [
      "npm run format:fix"
    ],
    "*.md": [
      "npm run lint:md"
    ]
  }
}
