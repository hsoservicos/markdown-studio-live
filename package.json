{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "markdown-studio",
  "version": "1.2.0",
  "description": "Editor Markdown com preview em tempo real — projeto pessoal e profissional. Reconstrução do tanabe/markdown-live-preview sob metodologia BMAD.",
  "keywords": [
    "markdown",
    "editor",
    "preview",
    "mermaid",
    "monaco",
    "vite"
  ],
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsoservicos/markdown-studio-live.git"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve-dist": "http-server dist -p 5001 -c-1",
    "build-and-serve": "npm run build && npm run serve-dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,yaml,md}\"",
    "format:fix": "prettier --write \"**/*.{js,mjs,json,yaml,md}\"",
    "quality": "npm run format:check && npm run lint && npm run lint:md && npm test",
    "prepare": "husky",
    "release": "node scripts/bump-version.js patch",
    "release:minor": "node scripts/bump-version.js minor",
    "release:major": "node scripts/bump-version.js major"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "github-markdown-css": "^5.9.0",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.47",
    "marked": "^15.0.7",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.7.4",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "npm run lint:fix",
      "npm run format:fix"
    ],
    "*.{json,yaml,md}": [
      "npm run format:fix"
    ],
    "*.md": [
      "npm run lint:md"
    ]
  }
}
