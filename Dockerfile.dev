# syntax=docker/dockerfile:1
#
# Markdown-Studio — container de desenvolvimento com hot-reload.
#
# Uso: docker compose -f compose.dev.yaml up

FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
